# Port the server listens on (the frontend dev proxy expects 3000).
PORT=3000

# Log level: error, warn, info, http, verbose, debug or silly.
LOG_LEVEL=info

# Upstream Memtime API.
MEMTIME_API_URL=https://interview-api.memtime-demo.deno.net/api/v1

# Consecutive Memtime failures (network errors, timeouts, 5xx) that stop calls to it (default 5).
MEMTIME_BREAKER_THRESHOLD=5

# How long calls stay stopped before one trial call, in milliseconds (default 30 seconds).
MEMTIME_BREAKER_OPEN_MS=30000

# How long a sign-in lasts, in milliseconds (absolute, default 1 hour).
SESSION_TTL_MS=3600000

# Failed sign-in attempts allowed per IP every 15 minutes.
SIGN_IN_RATE_LIMIT=10

# Proxies in front of the server (default false). Set to the number of proxies,
# e.g. 1 behind one reverse proxy, so the limit uses each client's own IP.
# Also accepts addresses or names such as loopback. Avoid true: it trusts any
# client-supplied X-Forwarded-For.
TRUST_PROXY=false

# Send the session cookie with the Secure flag (default true). Set false only
# for local development over plain http.
COOKIE_SECURE=false

# Session caps: total, and per API key.
MAX_SESSIONS=1000
MAX_SESSIONS_PER_KEY=5

# How long a user's time entries are used before Memtime is asked what changed,
# in milliseconds (default 5 minutes).
TIME_ENTRIES_CACHE_TTL_MS=300000

# How long a user's time entries stay in memory after their last check, in
# milliseconds (default 1 week). After that, the next visit loads them all again.
TIME_ENTRIES_KEEP_MS=604800000

# Most time entries held in memory across all users (default 200000). When over it, the
# user whose entries were stored longest ago is dropped and loads them all again.
TIME_ENTRIES_CACHE_MAX_ENTRIES=200000

# How long the client, project and task lists (and single lookups) are kept before
# Memtime is asked again, in milliseconds (default 5 minutes).
HIERARCHY_CACHE_TTL_MS=300000
